rules_version = '2';

// ============================================================================
// Security model
// ============================================================================
// - Anyone with the site link can READ everything (this matches the old
//   "viewer" mode: browse the calendar, schedule, findings, attendance).
// - Only a signed-in Firebase Auth user can WRITE to schedule, series,
//   findings, house rules, or the staff/PIN roster (this is "admin"). Since
//   you're the only one who will ever create a login, any signed-in user is
//   treated as admin — there's no separate roles system.
// - Attendance is special: anyone can CREATE a record (that's the public
//   Check In / Check Out kiosk — no login needed to punch in), but only admin
//   can UPDATE or DELETE one (corrections).
// - Staff PINs are readable by anyone. This is intentional and matches the
//   old app's trust level (PINs used to be visible in the page's own source
//   code; now they're visible via a Firestore read instead) — it is NOT real
//   secrecy, just a casual kiosk deterrent. If you need PINs to be truly
//   hidden from a determined snoop, that requires a Cloud Function so the
//   client never reads the staff collection directly — ask me if you want
//   that built later.
// - Claims are the exception to "anyone can create, only admin can read" —
//   they're admin-only to even view (amounts/receipts), but a PIN-matched
//   staff member can still CREATE their own claim (the "Submit a Claim"
//   kiosk), the same way anyone can create an attendance punch. They can't
//   read it back afterward, or see anyone else's claims, without admin login.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // The Check In / Check Out kiosk records a sign-in as a create (already allowed for
    // anyone below), but signing back OUT edits that same existing record — an update,
    // which used to require admin and silently failed for every kiosk user. This allows
    // an unauthenticated punch to touch only the punch fields; renaming, changing the
    // date, or deleting a record still requires admin.
    function isKioskPunch() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['signIn', 'signOut', 'signInLoc', 'signOutLoc']);
    }

    // The PIN-authenticated "Submit a Claim" kiosk saves a first-time signature back
    // onto the claimant's own staff record so future claims can reuse it, without
    // requiring the admin login. Same trust level as the PIN itself (a casual
    // deterrent, not real auth) — scoped to touching only this one field.
    function isSignatureUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['signatureUrl']);
    }

    match /schedule/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /series/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /findings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /plantGuide/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /plantTypes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /harvestDestinations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /harvests/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transplants/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /germinations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /losses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /envReadings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /staff/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isSignatureUpdate();
      allow delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || isKioskPunch();
      allow delete: if isAdmin();
    }

    match /specialEvents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /proposals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventoryAssets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventoryConsumables/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /purchasePlans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /purchaseAreas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reports/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reportTasks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tanks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Claims (expense reimbursement + receipts) are the one collection kept off the
    // "anyone can read" default above — amounts and receipt photos are more sensitive
    // than farm operations notes, so this needs an admin login to even view or manage.
    // Creating one is the exception, mirroring the attendance kiosk: the PIN-gated
    // "Submit a Claim" flow lets a staff member file their own claim (as a create)
    // without an admin login, but they can't read it back, edit it, or see anyone
    // else's — only admin can review, edit, or delete.
    match /claims/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Deleted records land here before being permanently removed (see moveToTrash()
    // in app.js) — admin-only in both directions since it can contain a copy of
    // anything from any other collection, including claims.
    match /trash/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
